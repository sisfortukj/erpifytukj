# ============================================================
# ERPify - konfigurasi untuk hosting Hostinger (Apache / LiteSpeed)
# File ini otomatis dibaca server. Tidak mengganggu website statis.
# ============================================================

# Jangan tampilkan daftar isi folder
Options -Indexes

# Encoding default
AddDefaultCharset UTF-8

# Blokir akses langsung ke file sensitif (database, backup, dokumentasi)
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|sqlite|sqlite3|db|log|ini|bak|old|orig)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|sqlite|sqlite3|db|log|ini|bak|old|orig)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ============================================================
# CACHE: agar update kode langsung terlihat tanpa hard refresh
# - HTML/CSS/JS/PHP selalu divalidasi ulang ke server (cepat: balasan 304 bila sama)
# - Gambar & font boleh di-cache lama karena jarang berubah
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js|php|json|txt)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header unset Expires
        Header unset Pragma
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
